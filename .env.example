# Vercel Postgres (Neon) — auto-injected by Vercel when you connect a DB to the project.
# Run `vercel env pull .env` after linking to populate locally.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# App secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# Anthropic API key — powers the AI Growth Insights tab in the Check-In Portal.
# Get one at https://console.anthropic.com. Insights are disabled until this is set.
ANTHROPIC_API_KEY=

# AiSensy WhatsApp — payment reminders. Prefer setting these in the admin
# Settings page (they override env). Template variables: {{1}} = member name,
# {{2}} = amount (₹...).
AISENSY_API_KEY=
AISENSY_PAYMENT_CAMPAIGN=
# Optional: a separate campaign for overdue payments (falls back to the one above).
AISENSY_PAYMENT_OVERDUE_CAMPAIGN=

# Public URL of your deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
